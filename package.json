{
  "name": "koven",
  "version": "1.0.0",
  "private": true,
  "description": "Windows-only Electron app with React, Radix, Tailwind, TypeScript, and Zustand.",
  "main": "./out/main/index.js",
  "os": [
    "win32"
  ],
  "author": {
    "name": "Koven"
  },
  "scripts": {
    "postinstall": "node scripts/confine.js install",
    "dev": "node scripts/confine.js dev",
    "start": "node scripts/confine.js dev",
    "preview": "node scripts/confine.js preview",
    "build": "node scripts/confine.js build",
    "build:unpack": "node scripts/confine.js unpack",
    "build:win": "node scripts/build-win.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && node scripts/check-file-budget.mjs && node scripts/check-capability-sync.mjs",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "new:capability": "node scripts/new-capability.mjs",
    "sync": "node scripts/sync.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.0",
    "zustand": "^5.0.8"
  }
}
